# Without DATABASE_URL the app boots in DEMO MODE (in-memory data, writes are
# volatile). With it, real PostgreSQL: npm run db:migrate && npm run db:seed
DATABASE_URL="postgres://usuario:clave@host/retorika_stay?sslmode=require"

# Secret used to sign the host session cookie (32+ characters)
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# Optional: assisted translation and editor assistant (Groq, free tier).
# Without a key both buttons report they are not configured and everything else
# keeps working exactly the same.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Optional: sign in with Google (OAuth 2.0 / OIDC). Without these the button is
# not rendered and email + password remains the only way in.
# Authorised redirect URI in the Google Cloud console:
#   https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
