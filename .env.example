# Sin DATABASE_URL la app arranca en MODO DEMO (datos en memoria, escrituras
# volatiles). Con ella, usa PostgreSQL real: npm run db:migrate && npm run db:seed
DATABASE_URL="postgres://usuario:clave@host/retorika_stay?sslmode=require"

# Clave para firmar la cookie de sesion del anfitrion (32+ caracteres)
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# Opcional: traduccion asistida (Groq, capa gratuita). Sin clave, el boton
# de traducir avisa de que no esta configurado y el editor manual sigue igual.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
